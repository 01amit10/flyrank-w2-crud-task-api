{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API (SQLite Backed)",
    "version": "2.0.0",
    "description": "FlyRank Week 3 A2 RESTful Task Management API backed by SQLite (better-sqlite3) with persistence, search, filtering, and stats."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "paths": {
    "/": { "get": { "summary": "API Metadata", "responses": { "200": { "description": "API metadata returned" } } } },
    "/health": { "get": { "summary": "Health check", "responses": { "200": { "description": "Server is healthy" } } } },
    "/stats": { "get": { "summary": "Task statistics", "responses": { "200": { "description": "Computed task statistics via SQL COUNT" } } } },
    "/tasks": {
      "get": {
        "summary": "List tasks with optional search, filter, and sort",
        "parameters": [
          { "name": "done", "in": "query", "schema": { "type": "string", "enum": ["true", "false"] }, "description": "Filter by completion status" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search keyword in task title" },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["title", "id"] }, "description": "Field to sort by" },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] }, "description": "Sort order" }
        ],
        "responses": { "200": { "description": "Array of tasks", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } } } } } }
      },
      "post": {
        "summary": "Create a task",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTask" }, "example": { "title": "Buy groceries" } } }
        },
        "responses": { "201": { "description": "Task created" }, "400": { "description": "Invalid request" } }
      }
    },
    "/tasks/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "get": { "summary": "Get one task by ID", "responses": { "200": { "description": "Task found" }, "404": { "description": "Task not found" } } },
      "put": {
        "summary": "Update a task",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTask" }, "examples": { "mark_done": { "value": { "done": true } }, "rename": { "value": { "title": "Buy organic groceries" } } } } }
        },
        "responses": { "200": { "description": "Task updated" }, "400": { "description": "Invalid request" }, "404": { "description": "Task not found" } }
      },
      "delete": { "summary": "Delete a task", "responses": { "204": { "description": "Task deleted" }, "404": { "description": "Task not found" } } }
    },
    "/tasks/{id}/done": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "patch": { "summary": "Toggle task done status", "responses": { "200": { "description": "Task toggled" }, "404": { "description": "Task not found" } } }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": ["id", "title", "done"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Finish Week 2 API" },
          "done": { "type": "boolean", "example": false },
          "createdAt": { "type": "string", "example": "2026-10-04T10:00:00.000Z" },
          "updatedAt": { "type": "string", "example": "2026-10-04T10:00:00.000Z" }
        }
      },
      "CreateTask": {
        "type": "object",
        "required": ["title"],
        "properties": { "title": { "type": "string", "example": "Buy groceries" } }
      },
      "UpdateTask": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "example": "Buy organic groceries" },
          "done": { "type": "boolean", "example": true }
        }
      }
    }
  }
}

